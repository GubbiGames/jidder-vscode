{
    "Jump": {
        "prefix": "jump",
        "body": [
            "-> ${1:Label}"
        ],
        "description": "Jump to node with label"
    },
    "Long Jump": {
        "prefix": "jump",
        "body": [
            "--> ${1:Label}"
        ],
        "description": "Jump to children of node with label"
    },
    "Condition": {
        "prefix": "condition",
        "body": [
            "{${1}}?"
        ],
        "description": "Only include line if condition is true."
    },

    "Attribute": {
        "prefix": "attribute",
        "body": [
            "[${1}:${2}]"
        ],
        "description": "Add an attribute"
    },
    "TagAttribute": {
        "prefix": "tag",
        "body": [
            "[${1}]"
        ],
        "description": "Add an attribute which does not have a key - only a value"
    },    
    "IdAttribute": {
        "prefix": "id",
        "body": [
            "[id:${1}]"
        ],
        "description": "Add an id attribute"
    }, 
    "LabelAttribute": {
        "prefix": "label",
        "body": [
            "[label:${1}]"
        ],
        "description": "Add a label attribute"
    }, 
    "AssetAttribute": {
        "prefix": "asset",
        "body": [
            "[asset:${1}]"
        ],
        "description": "Add an asset attribute"
    }


}
