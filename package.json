{
  "name": "jidder",
  "displayName": "Jidder",
  "description": "Adds support for the Jidder dialogue language.",
  "version": "0.1.0",
  "homepage": "https://www.jidder.dev/",
  "repository": "https://github.com/GubbiGames/jidder-vscode",
  "license": "MIT",
  "publisher": "Gubbi Games",
  "icon": "icon.png",
	"galleryBanner": {
		"color": "#ADE6FF",
		"theme": "light"
	},  
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "jidder",
      "aliases": ["Jidder"],
      "extensions": [".jdr"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "jidder",
      "scopeName": "source.jidder",
      "path": "./syntaxes/Jidder.tmLanguage.json"
    }],
		"snippets": [
			{
				"language": "jidder",
				"path": "./snippets.json"
			}
		],    
		"iconThemes": [
			{
				"id": "jidder-icons",
				"label": "Jidder Icons",
				"path": "./fileicons/jidder-icon-theme.json"
			}
		],    
    "configurationDefaults": {
      "[jidder]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.indentSize": 2,
        "editor.detectIndentation": false
      }
    }
  }
}
